# Database
DATABASE_URL="postgresql://user:password@localhost:5432/esports_tournament"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Public site URL (used for invitation links in emails; defaults to localhost if unset)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"

# Email (Resend) — optional; required to send real emails from the app
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Seed script (scripts/seed.ts) — optional overrides for the default admin user
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD="password123"
# SEED_ADMIN_USERNAME="admin"
# SEED_ADMIN_NAME="Admin"

# Playwright E2E — optional; used by tests/e2e/login.spec.ts when running npm run test:e2e
# E2E_EMAIL="admin@example.com"
# E2E_PASSWORD="password123"
# PLAYWRIGHT_BASE_URL="http://localhost:3000"

# Pusher — optional env vars for a future realtime phase (not wired in app code yet)
NEXT_PUBLIC_PUSHER_KEY="your-pusher-key"
PUSHER_SECRET="your-pusher-secret"
PUSHER_APP_ID="your-pusher-app-id"
PUSHER_CLUSTER="mt1"
