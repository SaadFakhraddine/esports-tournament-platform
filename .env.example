# Database
DATABASE_URL="postgresql://user:password@localhost:5432/esports_tournament"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Public site URL (used for invitation links in emails; defaults to localhost if unset)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OAuth Providers (optional — each provider is enabled only when both ID and secret are set)

# Google: https://console.cloud.google.com/apis/credentials — OAuth 2.0 Client ID (Web)
# Authorized redirect URIs: {NEXTAUTH_URL}/api/auth/callback/google
#   e.g. http://localhost:3000/api/auth/callback/google
# Complete OAuth consent screen; while publishing status is "Testing", add Test users.
# GOOGLE_* or AUTH_GOOGLE_* (either pair):
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
# AUTH_GOOGLE_ID="same-as-client-id"
# AUTH_GOOGLE_SECRET="same-as-client-secret"

# Discord: https://discord.com/developers/applications → OAuth2 → Redirects
# Add {NEXTAUTH_URL}/api/auth/callback/discord (e.g. http://localhost:3000/api/auth/callback/discord)
# Users need a verified email on Discord (identify + email scopes).
# Use DISCORD_* or Auth.js-style AUTH_DISCORD_* (either pair is enough):
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"
# AUTH_DISCORD_ID="same-as-client-id"
# AUTH_DISCORD_SECRET="same-as-client-secret"

# Email (Resend) — optional; required to send real emails from the app
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# AI — Bracket Designer coach (optional; Google AI Studio free tier: https://aistudio.google.com/apikey)
# Without this key, the planner still shows guide-style insights (no API call).
GEMINI_API_KEY=""
# Optional model override (default: gemini-2.5-flash)
# GEMINI_MODEL="gemini-2.5-flash"

# Seed script (scripts/seed.ts) — optional overrides for the default admin user
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD="password123"
# SEED_ADMIN_USERNAME="admin"
# SEED_ADMIN_NAME="Admin"

# Playwright E2E — optional; used by tests/e2e/login.spec.ts when running npm run test:e2e
# E2E_EMAIL="admin@example.com"
# E2E_PASSWORD="password123"
# PLAYWRIGHT_BASE_URL="http://localhost:3000"

# Pusher — optional env vars for a future realtime phase (not wired in app code yet)
NEXT_PUBLIC_PUSHER_KEY="your-pusher-key"
PUSHER_SECRET="your-pusher-secret"
PUSHER_APP_ID="your-pusher-app-id"
PUSHER_CLUSTER="mt1"
